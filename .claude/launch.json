{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Django Dev Server",
      "runtimeExecutable": "python",
      "runtimeArgs": ["manage.py", "runserver", "127.0.0.1:8000"],
      "port": 8000
    },
    {
      "name": "FastAPI Server",
      "runtimeExecutable": "uvicorn",
      "runtimeArgs": ["api_fastapi.main:app", "--reload", "--port", "8001"],
      "port": 8001
    }
  ]
}
