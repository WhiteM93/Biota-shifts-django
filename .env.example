# Скопируйте в `.env`. Пароли и DJANGO_SECRET_KEY — в `.env.secrets` (см. `.env.secrets.example`).

# --- PostgreSQL (Biota, источник отметок) ---
# Профиль для быстрого переключения между серверами Biota:
# - BIOTA_DB_PROFILE=MAIN -> BIOTA_DB_MAIN_*
# - BIOTA_DB_PROFILE=ALT  -> BIOTA_DB_ALT_*
# Пусто -> используются обычные BIOTA_DB_*.
BIOTA_DB_PROFILE=

BIOTA_DB_HOST=localhost
BIOTA_DB_PORT=5432
BIOTA_DB_NAME=biota_db
BIOTA_DB_USER=biota_user
BIOTA_DB_CONNECT_TIMEOUT=15

BIOTA_DB_MAIN_HOST=
BIOTA_DB_MAIN_PORT=5432
BIOTA_DB_MAIN_NAME=biota_db
BIOTA_DB_MAIN_USER=biota_user
BIOTA_DB_MAIN_CONNECT_TIMEOUT=15

BIOTA_DB_ALT_HOST=
BIOTA_DB_ALT_PORT=5432
BIOTA_DB_ALT_NAME=biota_db
BIOTA_DB_ALT_USER=biota_user
BIOTA_DB_ALT_CONNECT_TIMEOUT=15

BIOTA_ADMIN_USERNAME=admin

# При недоступности Biota PostgreSQL: 1 — не падать, отдавать пустые выборки (по умолчанию).
# BIOTA_DB_LOCAL_FALLBACK=0 — пробрасывать ошибку подключения.
# BIOTA_DEMO_DATA=1 — 10 демо-сотрудников в справочнике (график, регламенты); =0 — пустой справочник.
# Если BIOTA_DEMO_DATA не задан: при включённом fallback демо включается автоматически.

# ZKBioTA / zkbiota: уволенные с is_active=false скрыты по умолчанию (personnel_employee).
# Показать всех: BIOTA_INCLUDE_DISMISSED_EMPLOYEES=1
# Свой критерий: BIOTA_EMPLOYEE_ACTIVE_SQL=and e.status = 1

# --- PostgreSQL (Django default / site_db) ---
# Пустой SITE_DB_HOST → sqlite (db.sqlite3). Задан хост → PostgreSQL.
SITE_DB_HOST=
SITE_DB_PORT=5432
SITE_DB_NAME=site_db
SITE_DB_USER=site_user
SITE_DB_CONNECT_TIMEOUT=15
SITE_DB_CONN_MAX_AGE=60

# --- Django ---
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Производительность (пакет A, по умолчанию выключено) ---
# Включить все три оптимизации сразу:
# BIOTA_PERF_PACKAGE_A=1
# Откат без git: BIOTA_PERF_PACKAGE_A=0 и restart сервиса.
# По отдельности (перекрывают PACKAGE_A):
# BIOTA_PERF_MOBILE_GRAPH=1       — телефоны с /graph/ → /graph/mobile/
# BIOTA_PERF_DEFER_SCRIPTS=1      — (зарезервировано; biota_delete_btn.js всегда без defer)
# BIOTA_PERF_USERS_STORE_CACHE_SEC=60  — кэш JSON прав пользователей (0 = выкл.)

# Журнал медленных загрузок (админ: Кабинет → Медленные загрузки):
# BIOTA_PERF_DIAGNOSTICS=1
# BIOTA_PERF_DIAG_TTFB_MS=2500
# BIOTA_PERF_DIAG_LOAD_MS=5000
# BIOTA_PERF_DIAG_SERVER_MS=2000

# Публичный URL сайта (ссылки в письмах подтверждения email). Пример: https://biota.example.com
BIOTA_SITE_URL=http://127.0.0.1:8000

# Почта (подтверждение регистрации).
# Локально при DJANGO_DEBUG=1 письма НЕ уходят в интернет — только в консоль runserver (или ссылка на странице после регистрации).
# На сервере (DEBUG=0) обязательно задайте SMTP, иначе письма не дойдут:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=1
# DJANGO_DEFAULT_FROM_EMAIL=noreply@example.com

# --- График: Google Таблицы (опционально, переключатель на /graph/) ---
# Таблица «График МВ»: листы «Июль 2026», «Май 2026» и т.д.
# A (с 3-й строки) — табельный номер СКУД, B — ФИО, C+ — дни/смены (Д, от, …).
# pip install -r requirements-google.txt
# BIOTA_GOOGLE_SCHEDULE_SPREADSHEET_ID=1h7rJYYK6GMtPAh3BT0PWHufGnk2PeeDKRlULX5fglm4
# BIOTA_GOOGLE_SCHEDULE_CREDENTIALS=secrets/google-service-account.json
# Service account добавьте в таблицу: «Читатель» — загрузка, «Редактор» — сохранение с сайта.
# BIOTA_GOOGLE_SCHEDULE_READONLY=1 — не писать в Google, только читать + локальный Excel.
# Кэш Google (не ходит в API при каждом открытии; автообновление после 21:00 МСК):
# BIOTA_GOOGLE_SCHEDULE_REFRESH_HOUR=21
# BIOTA_GOOGLE_SCHEDULE_CACHE_DIR=
# Cron: 0 21 * * * cd /path/to/project && .venv/bin/python manage.py refresh_google_schedule
# Свой шаблон имени листа (необязательно):
# BIOTA_GOOGLE_SCHEDULE_SHEET={month_title}
