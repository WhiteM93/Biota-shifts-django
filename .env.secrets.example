# Скопируйте в .env.secrets и укажите реальные секреты.
# Файл .env.secrets добавлен в .gitignore и не должен попадать в Git.

# --- PostgreSQL (Biota, источник read-only) ---
BIOTA_DB_PASSWORD=
# Опционально, если используете BIOTA_DB_PROFILE:
BIOTA_DB_MAIN_PASSWORD=
BIOTA_DB_ALT_PASSWORD=

# --- PostgreSQL (Site DB) ---
SITE_DB_PASSWORD=

# --- Вход admin в приложение ---
BIOTA_ADMIN_USERNAME=admin
BIOTA_ADMIN_PASSWORD=

# --- Telegram: сводки СКУД (кабинет → Уведомления) ---
# Вариант A: через сервер бота (Biota → ваш сервер → Telegram)
BIOTA_NOTIFY_RELAY_URL=https://your-bot-server.example/api/biota/notify
BIOTA_NOTIFY_RELAY_SECRET=
# Кто может вызывать /api/notify/attendance/ из бота (пусто = chat_ids из BIOTA_TELEGRAM_CHAT_IDS)
# BIOTA_NOTIFY_TRIGGER_CHAT_IDS=577292537
# Уведомления склада в Telegram (пополнение, списание, выдача…)
# BIOTA_INVENTORY_NOTIFY=1
# Вариант B: напрямую из Biota (если relay не задан)
# Тот же токен, что BOT_TOKEN в проекте TgBot (@BotFather)
BIOTA_TELEGRAM_BOT_TOKEN=
# Chat ID: личка (число), канал @name или -100… — через запятую
BIOTA_TELEGRAM_CHAT_IDS=577292537
# Если сервер не видит api.telegram.org (No route to host) — HTTP/SOCKS прокси:
# BIOTA_TELEGRAM_PROXY=http://127.0.0.1:3128
# BIOTA_TELEGRAM_PROXY=socks5h://127.0.0.1:1080   # нужен: pip install PySocks
